:root{--yellow:#ffd21a;--black:#070707;--ink:#111;--paper:#f5f5f2;--muted:#747474;--line:rgba(0,0,0,.1);--radius:30px;--max:1240px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.5}body.no-scroll{overflow:hidden}a{text-decoration:none;color:inherit}button,input,select{font:inherit}button{cursor:pointer;border:0}.container{width:min(calc(100% - 48px),var(--max));margin:auto}.site-header{position:fixed;z-index:50;top:18px;left:0;width:100%}.nav{width:min(calc(100% - 48px),1180px);margin:auto;height:68px;border-radius:22px;display:flex;align-items:center;padding:8px 10px 8px 16px;gap:20px}.brand{display:flex;align-items:center;gap:9px;font-family:'Space Grotesk';font-weight:700;font-size:18px;letter-spacing:-.05em}.brand b{display:grid;place-items:center;width:35px;height:35px;border-radius:12px;background:var(--yellow);color:#000}.nav-links{display:flex;gap:4px;margin:auto}.nav-links a,.nav-about{padding:11px 14px;border-radius:13px;font-size:13px;font-weight:600;color:rgba(255,255,255,.7);transition:.25s}.nav-links a:hover,.nav-links a.active,.nav-about:hover{background:rgba(255,255,255,.1);color:#fff}.nav-actions{display:flex;align-items:center;gap:5px}.icon-btn,.menu-btn{background:rgba(255,255,255,.08);color:white;border-radius:13px;width:40px;height:40px}.icon-btn{font-size:25px;line-height:1}.menu-btn{display:none}.hero{min-height:100vh;background:#090909;color:#fff;position:relative;overflow:hidden;display:flex;align-items:center}.hero-media{position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1503614472-8c93d56e92ce?auto=format&fit=crop&w=2400&q=90');background-size:cover;background-position:center}.hero-vignette{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.28) 55%,rgba(0,0,0,.2)),linear-gradient(0deg,rgba(0,0,0,.6),transparent 45%)}.hero-content{position:relative;z-index:1;padding-top:100px}.eyebrow{font-size:11px;letter-spacing:.17em;font-weight:700;text-transform:uppercase;color:rgba(255,255,255,.7)}.eyebrow.dark{color:#777}.hero h1{font-family:'Space Grotesk';font-size:clamp(78px,13vw,175px);line-height:.79;letter-spacing:-.09em;margin:25px 0 34px;font-weight:600;text-transform:uppercase}.hero h1 em,h2 em{font-style:normal;color:var(--yellow)}.hero p{font-size:18px;max-width:420px;color:rgba(255,255,255,.78);margin:0 0 28px}.hero-actions{display:flex;gap:10px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:15px;min-height:50px;padding:0 20px;border-radius:15px;font-weight:700;font-size:13px;transition:.25s;position:relative;overflow:hidden}.btn:hover{transform:translateY(-2px)}.btn-yellow{background:var(--yellow);color:#050505}.btn-glass{color:#fff;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(18px)}.btn-dark{background:#0b0b0b;color:#fff}.hero-meta{position:absolute;bottom:34px;left:50%;transform:translateX(-50%);width:min(calc(100% - 48px),1180px);display:flex;justify-content:space-between;color:rgba(255,255,255,.65);font-size:11px;text-transform:uppercase;letter-spacing:.12em}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--yellow);margin-right:8px;box-shadow:0 0 0 5px rgba(255,210,26,.12)}.marquee{background:var(--yellow);overflow:hidden;white-space:nowrap;padding:16px 0}.marquee div{display:flex;justify-content:space-around;min-width:1200px;font-family:'Space Grotesk';font-weight:700;font-size:15px;letter-spacing:.12em}.marquee b{opacity:.4}.section{padding:125px 0}.intro{background:#f1f1ee}.intro-grid{display:grid;grid-template-columns:1fr 2.1fr;gap:60px}.intro h2,.section h2{font-family:'Space Grotesk';font-size:clamp(46px,6vw,82px);line-height:.98;letter-spacing:-.065em;margin:0 0 28px}.intro p{font-size:18px;max-width:680px;color:#555}.text-link{font-weight:700;font-size:14px;display:inline-flex;gap:15px;border-bottom:1px solid #bbb;padding-bottom:8px;margin-top:12px}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:40px}.section-head h2{font-size:clamp(42px,5vw,65px);margin-top:10px}.dest-grid{display:grid;grid-template-columns:1.15fr .85fr .85fr;grid-template-rows:300px 300px;gap:14px}.dest-card{position:relative;overflow:hidden;border-radius:26px;color:#fff;min-height:260px}.dest-card.tall{grid-row:span 2}.dest-card.wide{grid-column:2/4}.dest-card img{width:100%;height:100%;object-fit:cover;transition:transform .8s}.dest-card:hover img{transform:scale(1.06)}.dest-card:after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.7),transparent 55%)}.dest-card>div{position:absolute;z-index:1;left:25px;bottom:24px}.dest-card small{font-size:10px;letter-spacing:.15em;font-weight:700}.dest-card h3{font:600 42px/1 'Space Grotesk';letter-spacing:-.05em;margin:7px 0}.dest-card span{font-size:12px;color:#ddd}.black-section{background:#080808;color:#fff}.section-head.light p{max-width:320px;color:#888}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature-card{border:1px solid rgba(255,255,255,.1);border-radius:28px;padding:32px;min-height:360px;display:flex;flex-direction:column;transition:.3s;background:linear-gradient(145deg,rgba(255,255,255,.05),rgba(255,255,255,.01))}.feature-card:hover{transform:translateY(-7px);border-color:rgba(255,210,26,.4)}.feature-card.yellow{background:var(--yellow);color:#000}.feature-icon{font-size:35px;margin-bottom:auto}.feature-card small{font-size:10px;letter-spacing:.14em;opacity:.6}.feature-card h3{font:600 31px/1.05 'Space Grotesk';letter-spacing:-.04em;margin:12px 0}.feature-card p{color:#999;max-width:330px}.feature-card.yellow p{color:#5e5300}.feature-card button{background:none;color:inherit;text-align:left;font-weight:700;padding:14px 0 0}.explorer{background:#eaeae6}.explorer-card{border-radius:36px;padding:60px;display:grid;grid-template-columns:1fr 1fr;min-height:560px;overflow:hidden}.explorer h2{font-size:clamp(48px,5vw,72px);margin-top:16px}.explorer p{color:#666;max-width:440px;margin-bottom:28px}.canada-art{position:relative;min-height:390px;background:radial-gradient(circle at 55% 45%,rgba(255,210,26,.24),transparent 28%),linear-gradient(145deg,#ddd,#f7f7f4);border-radius:28px;overflow:hidden}.map-shape{position:absolute;width:78%;height:52%;left:12%;top:23%;background:#111;clip-path:polygon(0 28%,10% 18%,16% 21%,23% 8%,31% 18%,38% 12%,47% 24%,57% 17%,66% 29%,78% 25%,88% 41%,100% 51%,92% 64%,81% 61%,73% 73%,64% 65%,55% 83%,45% 75%,35% 91%,25% 72%,17% 77%,10% 59%,2% 58%);opacity:.92}.pin{position:absolute;z-index:2;background:var(--yellow);padding:6px 9px;border-radius:9px;font-size:10px;font-weight:700;box-shadow:0 7px 20px #0002}.p1{left:58%;top:62%}.p2{left:20%;top:51%}.p3{left:67%;top:55%}.p4{left:43%;top:22%}.stats{padding:65px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.stat-grid{display:grid;grid-template-columns:repeat(4,1fr)}.stat-grid div{padding:10px 30px;border-left:1px solid var(--line)}.stat-grid strong{font:600 54px/1 'Space Grotesk';display:block}.stat-grid span{font-size:12px;color:#777}.why-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}.why-grid article{padding:28px 25px 0;border-right:1px solid var(--line)}.why-grid b{font:600 22px 'Space Grotesk'}.why-grid p{color:#666;font-size:14px}.footer{background:#070707;color:#fff;padding:100px 0 28px}.footer-hero{border-bottom:1px solid #222;padding-bottom:90px}.footer-hero h2{font-size:clamp(54px,8vw,110px);max-width:950px;margin:20px 0 35px}.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:30px;padding:55px 0}.footer-grid p{color:#777}.footer-grid small{display:block;color:#666;font-size:10px;letter-spacing:.14em;margin-bottom:15px}.footer-grid a:not(.brand){display:block;color:#bbb;margin:9px 0;font-size:13px}.light-brand{color:#fff}.footer-bottom{border-top:1px solid #222;padding-top:20px;color:#666;display:flex;justify-content:space-between;font-size:10px}.search-overlay{position:fixed;inset:0;z-index:100;background:rgba(0,0,0,.65);backdrop-filter:blur(18px);display:none;align-items:flex-start;justify-content:center;padding-top:13vh}.search-overlay.open{display:flex}.search-box{width:min(700px,calc(100% - 30px));border-radius:30px;padding:35px;position:relative}.search-box h2{font-size:44px;margin:10px 0 20px}.search-box input{width:100%;height:62px;border:1px solid #ddd;border-radius:18px;padding:0 20px;background:#fff;outline:0}.close{position:absolute;right:20px;top:20px;width:40px;height:40px;border-radius:50%;background:#111;color:#fff;font-size:22px}.search-results{margin-top:15px}.result{padding:13px 0;border-bottom:1px solid #ddd;display:flex;justify-content:space-between}.toast{position:fixed;z-index:200;bottom:24px;left:50%;transform:translate(-50%,20px);background:#111;color:#fff;padding:13px 18px;border-radius:13px;font-size:12px;opacity:0;pointer-events:none;transition:.3s}.toast.show{opacity:1;transform:translate(-50%,0)}.loader{position:fixed;inset:0;background:#080808;z-index:300;display:grid;place-items:center;transition:.6s}.loader.hidden{opacity:0;pointer-events:none}.loader-logo{font:700 45px 'Space Grotesk';letter-spacing:-.08em;color:#fff}.loader-logo span{color:var(--yellow)}.loader-bar{position:absolute;bottom:35%;width:120px;height:2px;background:#222;overflow:hidden}.loader-bar i{display:block;width:100%;height:100%;background:var(--yellow);transform:translateX(-100%);animation:load 1.1s ease forwards}.mobile-menu{display:none}.page-hero{padding:190px 0 90px;background:#090909;color:#fff}.page-hero h1{font:600 clamp(65px,10vw,135px)/.85 'Space Grotesk';letter-spacing:-.08em;text-transform:uppercase;margin:20px 0}.page-hero p{max-width:560px;color:#aaa;font-size:17px}.toolbar{display:flex;gap:9px;flex-wrap:wrap;margin:0 0 35px}.chip{border:1px solid #ddd;background:#fff;border-radius:999px;padding:10px 15px;font-size:12px;font-weight:600}.chip.active,.chip:hover{background:#111;color:#fff;border-color:#111}.catalog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.catalog-card{background:#fff;border-radius:25px;overflow:hidden;border:1px solid #e5e5e2;transition:.3s}.catalog-card:hover{transform:translateY(-5px);box-shadow:0 20px 50px #0001}.catalog-img{height:210px;background-size:cover;background-position:center}.catalog-body{padding:22px}.catalog-body small{font-size:10px;color:#888;letter-spacing:.1em}.catalog-body h3{font:600 26px 'Space Grotesk';margin:8px 0}.catalog-body p{color:#777;font-size:13px}.meta-row{display:flex;justify-content:space-between;border-top:1px solid #eee;padding-top:14px;font-size:12px}.score{font-weight:800}.dark-page{background:#090909;color:#fff}.dark-page .catalog-card{background:#121212;border-color:#222}.dark-page .catalog-body p{color:#888}.search-panel{background:#fff;border-radius:25px;padding:22px;display:grid;grid-template-columns:repeat(4,1fr) auto;gap:10px;margin-bottom:30px}.field{border:1px solid #ddd;border-radius:14px;padding:10px 13px}.field label{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.1em;color:#888}.field input,.field select{width:100%;border:0;outline:0;background:transparent;padding-top:5px}.builder{display:grid;grid-template-columns:1fr 360px;gap:18px}.builder-main,.builder-side{background:#fff;border-radius:28px;padding:30px}.builder-side{position:sticky;top:20px;height:max-content}.builder-main h3{font:600 30px 'Space Grotesk'}.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.option{border:1px solid #ddd;padding:17px;border-radius:17px;display:flex;justify-content:space-between}.option.selected{border-color:#111;background:#fafafa}.total{font:600 48px 'Space Grotesk';letter-spacing:-.06em}.assistant{display:grid;grid-template-columns:1fr 1fr;gap:15px}.chat{background:#fff;border-radius:28px;padding:25px;min-height:420px}.bubble{max-width:80%;padding:13px 15px;border-radius:16px;background:#f0f0ed;margin:8px 0;font-size:13px}.bubble.user{margin-left:auto;background:#111;color:#fff}.chat-input{display:flex;gap:8px;margin-top:20px}.chat-input input{flex:1;border:1px solid #ddd;border-radius:13px;padding:13px}.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.team-card{background:#111;color:#fff;border-radius:27px;padding:28px;min-height:300px;display:flex;flex-direction:column;justify-content:end}.team-card:nth-child(2){background:var(--yellow);color:#000}.team-card:nth-child(3){background:#ddd;color:#000}.team-card b{font:600 32px 'Space Grotesk'}.tech{background:#0a0a0a;color:#fff;border-radius:32px;padding:45px}.code{font-family:monospace;color:#aaa;line-height:1.8;white-space:pre-wrap}.notice{padding:15px 18px;background:#fff8cf;border:1px solid #eadb75;border-radius:15px;font-size:12px;color:#635800}
